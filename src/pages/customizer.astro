---
/**
 * Theme customizer — app-like shell: variables panel (left), sandboxed demo
 * iframe (center), themes/presets panel (right). The panels slide out as
 * popovers on narrow screens. All styles are data-attribute scoped and split
 * into one cascade layer per component so they stay independent; see
 * docs/plans/theme-customizer.md.
 */
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import bladesStyles from '@anyblades/blades/layered/blades.layered?inline';
// The demo iframe is sandboxed (opaque origin), so remote font URLs are
// blocked — inline the font binary as a data URL, same as DocsDemoPreview.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?inline';
import knivesStyles from '../assets/roles/knives.css?inline';
import { categories, variables } from '../customizer/registry';

const interFaceStyles = `@font-face {
	font-family: 'Inter Variable';
	font-style: normal;
	font-display: swap;
	font-weight: 100 900;
	src: url("${interLatin}") format('woff2-variations');
	unicode-range: U+0000-00FF, U+0131, U+0152-0134, U+0155-0156, U+0159-015A, U+0161, U+017D, U+017F, U+0180, U+0182, U+0184, U+0189, U+01D3, U+01F9, U+0208-0209, U+020E-0211, U+021C, U+0221-0222, U+02DE-MFFF, U+0263, U+021C, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}`;

/** Kitchen-sink demo body: semantic HTML the variables visibly affect. */
const demoMarkup = `
<h2>Heading 2</h2>
<p>
	Body text with <a href="#">a link</a>, <strong>strong</strong> and <em>emphasis</em>,
	an <code>inline code</code>, <kbd>Ctrl</kbd>, <mark>mark</mark>, <ins>ins</ins> and <del>del</del>.
</p>
<p>
	<button>Button</button>
	<button data-variant="outline">Outline</button>
	<button data-variant="contrast">Contrast</button>
</p>
<form>
	<input type="text" placeholder="Text input" aria-label="Text input">
	<label><input type="checkbox">Checkbox</label>
	<input type="range" aria-label="Range">
</form>
<blockquote>
	<p>A blockquote for borders and footers.</p>
	<footer>— An attribution</footer>
</blockquote>
<table>
	<thead><tr><th>Column</th><th>Value</th></tr></thead>
	<tbody>
		<tr><td>Alpha</td><td>10</td></tr>
		<tr><td>Beta</td><td>20</td></tr>
	</tbody>
</table>
<pre><code>console.log("Hi")</code></pre>
<hr>
`;

const demoDoc = `<!doctype html>
<html lang="en" style="height: 100%">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<style>${bladesStyles}${interFaceStyles}${knivesStyles}
			body { height: 100%; padding: 2rem; display: grid; gap: 1.25rem; align-content: start; }
		</style>
	</head>
	<body>${demoMarkup}<script>
		const overrides = document.createElement('style');
		overrides.id = 'cx-vars';
		document.head.append(overrides);
		addEventListener('message', (event) => {
			const data = event.data || {};
			if (data.type === 'knives-cx' && typeof data.css === 'string') overrides.textContent = data.css;
			if (data.type === 'knives-cx-scheme') {
				if (data.theme) document.documentElement.dataset.theme = String(data.theme);
				else delete document.documentElement.dataset.theme;
			}
		});
	</script></body>
</html>`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Theme customizer — ${SITE_TITLE}`}
			description="Customize Blades themes live and save your own presets."
		>
			<style is:global>
				/* One cascade layer per component: the layout never reaches into the
				   panels, and each component can be reworked in isolation. Keep
				   everything data-attribute scoped — no classes per AGENTS.md. */
				@layer cx.layout, cx.panel, cx.fields, cx.themes, cx.chrome;
			</style>
		</BaseHead>
	</head>
	<body data-cx>
		<header data-cx-toolbar>
			<strong>Theme customizer</strong>
			<div role="group" aria-label="Demo color scheme" data-cx-scheme>
				<button data-cx-scheme-button="system" aria-pressed="true">
					System
				</button>
				<button data-cx-scheme-button="light" aria-pressed="false">
					Light
				</button>
				<button data-cx-scheme-button="dark" aria-pressed="false">
					Dark
				</button>
			</div>
			<button popovertarget="cx-panel-vars" data-cx-slot-toggle aria-expanded="false">
				Variables
			</button>
			<button popovertarget="cx-panel-themes" data-cx-slot-toggle aria-expanded="false">
				Themes
			</button>
		</header>

		<div data-cx-shell>
			<!-- Variables panel -->
			<aside id="cx-panel-vars" data-cx-panel popover>
				<h2>Variables</h2>
				<div data-cx-panel-body>
					{categories.map((category) => (
						<section data-cx-group>
							<h3>{category}</h3>
							<ul>
								{variables
									.filter((v) => v.category === category)
									.map((v) => (
										<li data-cx-row={v.id} data-type={v.type}>
											<span data-cx-name>
												<code>{v.name}</code>
											</span>
											<span data-cx-input>
												{v.type === 'color' ? (
													<input
														name="value"
														type="color"
														value={v.swatch ?? '#7f7f7f'}
														title={`${v.name} — defaults to the Blades initial value`}
													/>
												) : (
													<input
														name="value"
														type="text"
														placeholder="initial"
														value={v.type === 'length' || v.type === 'text' ? (v.sample ?? '') : ''}
														title={`${v.name} — edit to override`}
													/>
												)}
											</span>
											<button data-cx-reset title="Reset to the initial value" disabled>
												⟲
											</button>
											<small data-cx-current>initial</small>
										</li>
									))}
							</ul>
						</section>
					))}
				</div>
				<footer data-cx-bar>
					<span>
						<b id="cx-modified">0</b> modified
					</span>
					<button id="cx-reset-all" disabled>
						Reset all
					</button>
				</footer>
			</aside>

			<!-- Demo -->
			<main data-cx-demo>
				<iframe
					id="cx-demo"
					title="Theme demo (kitchen sink)"
					sandbox="allow-scripts"
					srcdoc={demoDoc}
				></iframe>
			</main>

			<!-- Themes -->
			<aside id="cx-panel-themes" data-cx-panel popover>
				<h2>Themes</h2>
				<form data-cx-save onsubmit="return false;">
					<label>
						Name
						<input id="cx-name" type="text" value="My theme" />
					</label>
					<button id="cx-save" type="button">
						Save
					</button>
					<span id="cx-dirty" hidden aria-label="Unsaved changes">
						●
					</span>
				</form>
				<div data-cx-panel-body>
					<section aria-label="Themes">
						<h3>Presets &amp; saved</h3>
						<ol id="cx-theme-list"></ol>
					</section>
				</div>
			</aside>
		</div>

		<div id="cx-notice" popover role="status"></div>

		<script>
			import '../customizer/customizer';
		</script>
	</body>
</html>

<style is:global>
	@layer cx.layout {
		/* App shell: a toolbar row over a three-zone body. */
		body[data-cx] {
			display: grid;
			grid-template-rows: auto minmax(0, 1fr);
			height: 100svh;
		}

		[data-cx-toolbar] {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.5rem 0.75rem;
			border-bottom: var(--pico-border-width) solid var(--pico-muted-border-color);

			> strong {
				font-size: 0.9rem;
			}

			> [data-cx-scheme] {
				display: flex;
				gap: 0.125rem;
				margin-inline-start: auto;

				button {
					font-size: 0.75rem;
					padding: 0.3rem 0.55rem;
					box-shadow: none;
					background: transparent;
					border: 0;
					color: var(--pico-muted-color);
					font-weight: 400;

					&:hover {
						color: var(--pico-color);
					}

					&[aria-pressed='true'] {
						background: var(--pico-secondary-background);
						color: var(--pico-secondary);
						font-weight: 600;
					}
				}
			}

			> [data-cx-slot-toggle] {
				font-size: 0.75rem;
				padding: 0.3rem 0.55rem;
				box-shadow: none;
				background: transparent;
				border-color: var(--pico-muted-border-color);
				color: var(--pico-muted-color);
			}
		}

		[data-cx-shell] {
			display: flex;
			min-height: 0;
			height: 100%;
		}

		[data-cx-demo] {
			flex: 1;
			min-width: 0;
			overflow: hidden;

			> iframe {
				display: block;
				width: 100%;
				height: 100%;
				border: 0;
				background: var(--pico-background-color);
			}
		}

		/* Narrow screens: the panels are popovers (drawers), the toggles show. */
		@media (width < 1100px) {
			/* Explicit display so the author rule beats neither open state here. */
			[data-cx-panel]:popover-open {
				display: flex;
				position: fixed;
				inset-block: 0;
				inset-inline-start: auto;
				inset-inline-end: 0;
				height: 100%;
				max-height: none;
				width: min(21rem, 94vw);
				margin: 0;
				border-radius: 0;
				box-shadow: -12px 0 32px rgb(0 0 0 / 0.25);
			}
		}

		@media (min-width: 1100px) {
			[data-cx-slot-toggle] {
				display: none;
			}

			/* The panel slots sit in the shell flow; popover affordances are
			   pointless (nothing can open them) and display:flex beats the UA's
			   hidden-closed-popover rule. */
			[data-cx-panel] {
				display: flex;
				position: static;
				inset: auto;
			}
		}
	}

	@layer cx.panel {
		[data-cx-panel] {
			flex: none;
			width: 18rem;
			flex-direction: column;
			background: var(--pico-background-color);

			> h2 {
				flex: none;
				margin: 0;
				padding: 0.6rem 1rem;
				border-bottom: var(--pico-border-width) solid var(--pico-muted-border-color);
				font-size: 0.9rem;
			}
		}

		/* Wide screens get slot borders instead of floating overlays. */
		@media (min-width: 1100px) {
			#cx-panel-vars {
				border-right: var(--pico-border-width) solid var(--pico-muted-border-color);
			}

			#cx-panel-themes {
				border-left: var(--pico-border-width) solid var(--pico-muted-border-color);
			}
		}

		[data-cx-panel-body] {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
			scrollbar-width: thin;
			padding-block: 0.25rem 1rem;
		}

		[data-cx-group] > h3,
		#cx-panel-themes > div > section > h3 {
			position: sticky;
			top: 0;
			z-index: 1;
			background: var(--pico-background-color);
			margin: 0;
			padding: 0.5rem 1rem 0.3rem;
			text-transform: uppercase;
			letter-spacing: 0.01rem;
			font-size: 0.68rem;
			font-weight: 600;
			color: var(--pico-muted-color);
		}

		#cx-panel-vars > footer:last-of-type,
		[data-cx-bar] {
			flex: none;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.5rem 0.75rem;
			border-top: var(--pico-border-width) solid var(--pico-muted-border-color);
			font-size: 0.78rem;

			> b {
				font-size: 0.85rem;
			}
		}

		[data-cx-bar] > button,
		[data-cx-save] > button,
		#cx-theme-list button {
			font-size: 0.72rem;
			padding: 0.22rem 0.4rem;
			box-shadow: none;
			background: transparent;
			border: 0;
			color: var(--pico-primary);

			&:disabled {
				color: var(--pico-muted-color);
			}
		}
	}

	@layer cx.fields {
		[data-cx-row] {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.3rem 0.75rem;
			box-shadow: 0 1px 0 color-mix(in srgb, var(--pico-muted-border-color) 45%, transparent);

			> [data-cx-name] {
				flex: 1;
				min-width: 0;

				> code {
					display: block;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
					font-size: 0.72rem;
				}
			}

			> [data-cx-input] {
				flex: none;

				> input[type='text'] {
					width: 5.5rem;
					height: 1.85rem;
					padding: 0.1rem 0.4rem;
					margin: 0;
					font-size: 0.72rem;

					&::placeholder {
						color: var(--pico-muted-color);
						opacity: 0.7;
					}
				}

				> input[type='color'] {
					width: 2.1rem;
					height: 1.85rem;
					padding: 0.15rem;
					margin: 0;
					border: var(--pico-border-width) solid var(--pico-muted-border-color);
					border-radius: var(--pico-border-radius);
					background: transparent;
				}
			}

			> button[data-cx-reset] {
				flex: none;
				width: 1.6rem;
				height: 1.6rem;
				padding: 0;
				margin: 0;
				background: transparent;
				border: 0;
				box-shadow: none;
				border-radius: 50%;
				font-size: 0.8rem;
				color: var(--pico-muted-color);

				&:hover:not(:disabled) {
					background: color-mix(in srgb, var(--pico-muted-border-color) 60%, transparent);
					color: var(--pico-color);
				}

				&:disabled {
					visibility: hidden;
				}
			}

			> [data-cx-current] {
				flex: none;
				width: 3rem;
				text-align: end;
				font-size: 0.62rem;
				color: var(--pico-muted-color);
				opacity: 0.85;
			}
		}
	}

	@layer cx.themes {
		form[data-cx-save] {
			display: flex;
			align-items: flex-end;
			gap: 0.4rem;
			padding: 0.6rem 1rem;
			border-bottom: var(--pico-border-width) solid var(--pico-muted-border-color);

			> label {
				flex: 1;
				min-width: 0;
				margin: 0;
				font-size: 0.68rem;
				color: var(--pico-muted-color);

				> input {
					height: 1.85rem;
					padding: 0.1rem 0.4rem;
					margin: 0.2rem 0 0;
					font-size: 0.8rem;
				}
			}

			> #cx-dirty {
				color: var(--pico-primary);
				font-size: 0.9rem;
			}
		}

		#cx-theme-list {
			list-style: none;
			margin: 0;
			padding: 0.25rem 0 0;

			li {
				display: flex;
				align-items: center;
				gap: 0.15rem;
				padding: 0.22rem 0.6rem 0.22rem 1rem;

				& + li {
					box-shadow: 0 1px 0 color-mix(in srgb, var(--pico-muted-border-color) 45%, transparent);
				}

				> span {
					flex: 1;
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
					font-size: 0.78rem;
				}

				> b {
					color: var(--pico-primary);
					font-size: 0.66rem;
				}
			}

			[data-cx-empty] {
				padding: 0.35rem 1rem;
				font-size: 0.72rem;
				color: var(--pico-muted-color);
			}
		}
	}

	@layer cx.chrome {
		#cx-notice {
			position: fixed;
			inset-block-end: 1rem;
			inset-inline: 0;
			margin-inline: auto;
			width: max-content;
			max-width: 92vw;
			padding: 0.45rem 0.9rem;
			background: var(--pico-background-color);
			border: var(--pico-border-width) solid var(--pico-primary-border);
			border-radius: var(--pico-border-radius);
			box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
			font-size: 0.78rem;
		}
	}
</style>
